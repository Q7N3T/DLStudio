# ─────────────────────────────────────────────────────────────────────────────
# DL Studio — переменные окружения для docker compose (локальная разработка).
# Скопируйте в .env и при необходимости поменяйте. Все значения ниже — dev-значения
# по умолчанию; docker-compose.yml работает и без .env.
# Секреты никогда не коммитим: .env в .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=medusa
POSTGRES_PASSWORD=medusa
POSTGRES_DB=medusa
# Порт Postgres на хосте (для запуска бэкенда без Docker)
POSTGRES_PORT=5432

# Redis: порт на хосте
REDIS_PORT=6379

# Секреты Medusa. В продакшене — длинные случайные строки: openssl rand -hex 32
JWT_SECRET=dev-jwt-secret
COOKIE_SECRET=dev-cookie-secret

# CORS (через запятую)
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:8000,http://localhost:9000,http://localhost:5173

# Пользователь админки, создаётся при первом запуске
MEDUSA_ADMIN_EMAIL=admin@dlstudio.local
MEDUSA_ADMIN_PASSWORD=supersecret

# Витрина: регион по умолчанию (ISO-2 страны)
NEXT_PUBLIC_DEFAULT_REGION=ru
# Публичный ключ Medusa (pk_...). В Docker подставляется автоматически из бэкенда;
# задавайте вручную только при запуске витрины без Docker.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# ── Появятся на следующих этапах ──
# YOOKASSA_SHOP_ID=            # этап 4: ЮKassa
# YOOKASSA_SECRET_KEY=
# TELEGRAM_BOT_TOKEN=          # этап 5: уведомления о заказах
# TELEGRAM_CHAT_ID=
