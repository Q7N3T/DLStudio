# Источник данных каталога: "mock" (JSON-фикстуры, по умолчанию) или "woo" (WooCommerce Store API)
CATALOG_PROVIDER=mock

# Базовый адрес WordPress/WooCommerce. Store API: ${WOO_BASE_URL}/wp-json/wc/store/v1
WOO_BASE_URL=https://dlstudio.store

# Канонический адрес витрины (метаданные, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://dlstudio.store

# Разрешить запросы на запись (корзина, заказы) в рабочий WooCommerce.
# Держать false, пока владелец явно не подтвердит.
WOO_ALLOW_WRITES=false
