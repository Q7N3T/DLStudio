{
  "name": "dlstudio",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:dev": "turbo dev --filter=@dlstudio/backend",
    "backend:seed": "turbo seed --filter=@dlstudio/backend",
    "storefront:dev": "turbo dev --filter=@dlstudio/storefront",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.23.0",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turbo": "^2.0.14",
    "ajv": "^8.13.0"
  },
  "workspaces": [
    "backend",
    "storefront",
    "!backend/.medusa/**"
  ],
  "overrides": {
    "eslint": {
      "ajv": "^6.12.4"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.4"
    }
  },
  "description": "DL Studio: магазин одежды на Medusa v2 + Next.js"
}
