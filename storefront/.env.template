# Витрина без Docker (npm run storefront:dev). Скопируйте в storefront/.env.local.

# Публичный ключ Medusa (pk_...): админка → Settings → Publishable API Keys,
# или `medusa exec ./src/scripts/write-publishable-key.ts` в backend/.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Адрес API Medusa
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Регион по умолчанию (ISO-2 страны)
NEXT_PUBLIC_DEFAULT_REGION=ru

# Публичный адрес витрины: канонические URL, JSON-LD, robots.txt, sitemap.xml
NEXT_PUBLIC_BASE_URL=http://localhost:8000
