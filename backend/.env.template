# Бэкенд без Docker (npm run backend:dev). Скопируйте в backend/.env.
# Postgres и Redis можно поднять из корня: docker compose up -d postgres redis
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa
REDIS_URL=redis://localhost:6379

STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:8000,http://localhost:9000,http://localhost:5173

JWT_SECRET=dev-jwt-secret
COOKIE_SECRET=dev-cookie-secret

# Куда записать публичный ключ для витрины (medusa exec ./src/scripts/write-publishable-key.ts)
PUBLISHABLE_KEY_FILE=../storefront/.publishable-key
